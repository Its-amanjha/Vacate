{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/vacate/vacate/schemas/compare.schema.json",
  "title": "vacate scan comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tool",
    "comparedAt",
    "platform",
    "machine",
    "redacted",
    "newerRun",
    "olderRun",
    "summary",
    "gone",
    "stillThere",
    "new",
    "notComparable"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "vacate" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "comparedAt": { "$ref": "#/definitions/isoTime" },
    "platform": { "$ref": "#/definitions/platform" },
    "machine": { "type": "string", "minLength": 1 },
    "redacted": { "type": "boolean" },
    "newerRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "finishedAt", "traces"],
      "properties": {
        "path": { "type": "string" },
        "finishedAt": { "$ref": "#/definitions/isoTime" },
        "traces": { "type": "integer", "minimum": 0 }
      }
    },
    "olderRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "finishedAt", "traces"],
      "properties": {
        "path": { "type": "string" },
        "finishedAt": { "$ref": "#/definitions/isoTime" },
        "traces": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gone", "stillThere", "new", "notComparable"],
      "properties": {
        "gone": { "type": "integer", "minimum": 0 },
        "stillThere": { "type": "integer", "minimum": 0 },
        "new": { "type": "integer", "minimum": 0 },
        "notComparable": { "type": "integer", "minimum": 0 }
      }
    },
    "gone": {
      "type": "array",
      "items": { "$ref": "#/definitions/traceItem" }
    },
    "stillThere": {
      "type": "array",
      "items": { "$ref": "#/definitions/stillThereItem" }
    },
    "new": {
      "type": "array",
      "items": { "$ref": "#/definitions/traceItem" }
    },
    "notComparable": {
      "type": "array",
      "items": { "$ref": "#/definitions/notComparableItem" }
    }
  },
  "definitions": {
    "isoTime": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "platform": { "enum": ["windows", "macos", "linux"] },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resolved"],
      "properties": {
        "kind": { "enum": ["path", "registry", "wmi", "installed-program", "system-query"] },
        "resolved": { "type": "string", "minLength": 1 }
      }
    },
    "traceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "category", "title", "locator", "sizeBytes", "lastWriteTime"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "locator": { "$ref": "#/definitions/locator" },
        "sizeBytes": { "type": ["integer", "null"], "minimum": 0 },
        "lastWriteTime": {
          "anyOf": [
            { "$ref": "#/definitions/isoTime" },
            { "type": "null" }
          ]
        }
      }
    },
    "stillThereItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "category",
        "title",
        "locator",
        "olderSizeBytes",
        "newerSizeBytes",
        "sizeDeltaBytes",
        "olderLastWriteTime",
        "newerLastWriteTime"
      ],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "locator": { "$ref": "#/definitions/locator" },
        "olderSizeBytes": { "type": ["integer", "null"], "minimum": 0 },
        "newerSizeBytes": { "type": ["integer", "null"], "minimum": 0 },
        "sizeDeltaBytes": { "type": ["integer", "null"] },
        "olderLastWriteTime": {
          "anyOf": [
            { "$ref": "#/definitions/isoTime" },
            { "type": "null" }
          ]
        },
        "newerLastWriteTime": {
          "anyOf": [
            { "$ref": "#/definitions/isoTime" },
            { "type": "null" }
          ]
        }
      }
    },
    "notComparableItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "category", "title", "olderStatus", "newerStatus", "reason"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "olderStatus": { "type": "string" },
        "newerStatus": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
