{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/vacate/vacate/schemas/report.schema.json",
  "title": "vacate scan report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tool", "scan", "catalog", "summary", "traces", "installedPrograms", "skipped", "errors", "limitations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "vacate" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "finishedAt", "durationMs", "platform", "elevated", "budgetSeconds", "ruleTimeoutSeconds", "complete", "redacted", "host"],
      "properties": {
        "startedAt": { "$ref": "#/definitions/isoTime" },
        "finishedAt": { "$ref": "#/definitions/isoTime" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "platform": { "$ref": "#/definitions/platform" },
        "elevated": { "type": "boolean" },
        "budgetSeconds": { "type": "integer", "minimum": 1 },
        "ruleTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "complete": { "type": "boolean" },
        "redacted": { "type": "boolean" },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "os", "version", "architecture", "user", "volumes"],
          "properties": {
            "name": { "type": "string" },
            "os": { "type": "string" },
            "version": { "type": "string" },
            "architecture": { "type": "string" },
            "user": { "type": "string" },
            "volumes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "fileSystem", "sizeBytes", "freeBytes"],
                "properties": {
                  "name": { "type": "string" },
                  "fileSystem": { "type": ["string", "null"] },
                  "sizeBytes": { "type": ["integer", "null"], "minimum": 0 },
                  "freeBytes": { "type": ["integer", "null"], "minimum": 0 }
                }
              }
            }
          }
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "rulesLoaded", "unverified", "invalidFiles"],
      "properties": {
        "version": { "type": "string" },
        "rulesLoaded": { "type": "integer", "minimum": 0 },
        "unverified": { "type": "array", "items": { "type": "string" } },
        "invalidFiles": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byCategory", "totalRules", "rulesRun", "rulesSkipped", "rulesFailed", "rulesNotApplicable", "tracesFound", "totalBytes"],
      "properties": {
        "byCategory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["category", "traces", "sizeBytes", "highestSensitivity"],
            "properties": {
              "category": { "type": "string" },
              "traces": { "type": "integer", "minimum": 0 },
              "sizeBytes": { "type": "integer", "minimum": 0 },
              "highestSensitivity": { "$ref": "#/definitions/sensitivity" }
            }
          }
        },
        "totalRules": { "type": "integer", "minimum": 0 },
        "rulesRun": { "type": "integer", "minimum": 0 },
        "rulesSkipped": { "type": "integer", "minimum": 0 },
        "rulesFailed": { "type": "integer", "minimum": 0 },
        "rulesNotApplicable": { "type": "integer", "minimum": 0 },
        "tracesFound": { "type": "integer", "minimum": 0 },
        "totalBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "traces": { "type": "array", "items": { "$ref": "#/definitions/trace" } },
    "installedPrograms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "publisher", "version", "installDate", "scope"],
        "properties": {
          "name": { "type": "string" },
          "publisher": { "type": ["string", "null"] },
          "version": { "type": ["string", "null"] },
          "installDate": { "type": ["string", "null"] },
          "scope": { "enum": ["user", "machine", "system", "unknown"] }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "reason", "detail"],
        "properties": {
          "ruleId": { "type": "string" },
          "reason": { "enum": ["requires-elevation", "budget", "permission", "unavailable", "timeout"] },
          "detail": { "type": ["string", "null"] }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "message", "type"],
        "properties": {
          "ruleId": { "type": "string" },
          "message": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "text"],
        "properties": {
          "scope": { "enum": ["all", "windows", "macos", "linux"] },
          "text": { "type": "string", "minLength": 10 }
        }
      }
    }
  },
  "definitions": {
    "isoTime": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "platform": { "enum": ["windows", "macos", "linux"] },
    "sensitivity": { "enum": ["low", "medium", "high", "critical"] },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "platform", "category", "title", "sensitivity", "locator", "exists", "sizeBytes", "itemCount", "lastWriteTime", "samples", "truncated", "confidence", "requiresElevation", "error"],
      "properties": {
        "ruleId": { "type": "string" },
        "platform": { "$ref": "#/definitions/platform" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "sensitivity": { "$ref": "#/definitions/sensitivity" },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "resolved"],
          "properties": {
            "kind": { "enum": ["path", "registry", "wmi", "installed-program", "system-query"] },
            "resolved": { "type": "string", "minLength": 1 }
          }
        },
        "exists": { "type": "boolean" },
        "sizeBytes": { "type": ["integer", "null"], "minimum": 0 },
        "itemCount": { "type": ["integer", "null"], "minimum": 0 },
        "lastWriteTime": { "anyOf": [{ "$ref": "#/definitions/isoTime" }, { "type": "null" }] },
        "samples": { "type": "array", "maxItems": 3, "items": { "type": "string" } },
        "truncated": { "type": "boolean" },
        "confidence": { "enum": ["verified", "unverified"] },
        "requiresElevation": { "type": "boolean" },
        "error": { "type": ["string", "null"] },
        "properties": { "type": "object" }
      }
    }
  }
}
