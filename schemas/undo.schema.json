{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/vacate/vacate/schemas/undo.schema.json",
  "title": "vacate undo log",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tool", "platform", "machine", "run", "createdAt", "entries"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "vacate" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "platform": { "enum": ["windows", "macos", "linux"] },
    "machine": { "type": "string", "minLength": 1 },
    "run": { "type": "string", "minLength": 1, "pattern": "^[^\\\\/]+$" },
    "createdAt": { "$ref": "#/definitions/isoTime" },
    "entries": { "type": "array", "items": { "$ref": "#/definitions/entry" } }
  },
  "definitions": {
    "isoTime": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "step", "ruleId", "originalPath", "trashLocation", "isDirectory", "sizeBytes", "movedAt", "restoredAt"],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "step": { "type": "integer", "minimum": 1 },
        "ruleId": { "type": "string", "minLength": 1 },
        "originalPath": { "type": "string", "minLength": 1 },
        "trashLocation": { "type": ["string", "null"], "minLength": 1 },
        "isDirectory": { "type": "boolean" },
        "sizeBytes": { "type": ["integer", "null"], "minimum": 0 },
        "movedAt": { "$ref": "#/definitions/isoTime" },
        "restoredAt": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/isoTime" }
          ]
        }
      }
    }
  }
}
