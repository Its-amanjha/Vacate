{
    "id":  "credentials.windows.dpapi-masterkeys",
    "platforms":  [
                      "windows"
                  ],
    "category":  "credentials",
    "title":  "DPAPI master keys",
    "whyItMatters":  "These per-user keys unlock protected passwords, cookies and Wi-Fi secrets. Their presence shows which protected secrets the account could recover.",
    "sensitivity":  "critical",
    "locator":  {
                    "kind":  "path",
                    "root":  "APPDATA",
                    "path":  "Microsoft/Protect",
                    "match":  "directories",
                    "recurse":  true
                },
    "measure":  [
                    "exists",
                    "sizeBytes",
                    "lastWriteTime",
                    "itemCount"
                ],
    "maxEntries":  5000,
    "requiresElevation":  false,
    "verifiedOn":  [
                       "Windows 11 Pro 26300"
                   ],
    "verified":  true,
    "source":  "DPAPI master keys: https://www.thehacker.recipes/ad/movement/credentials/dumping/dpapi-protected-secrets (%APPDATA%/Microsoft/Protect/\u003cSID\u003e)",
    "notes":  "Contains per-SID folders with GUID master-key files plus CREDHIST and Preferred. Machine keys under System32/Microsoft/Protect are not covered here."
}